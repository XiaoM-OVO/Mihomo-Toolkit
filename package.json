{
  "name": "mihomo-toolkit",
  "version": "1.7.0",
  "description": "Mihomo-Toolkit - 自动化节点清洗与策略组构建工具",
  "main": "src/index.js",
  "types": "index.d.ts",
  "bin": {
    "mihomo-toolkit": "src/targets/cli.js",
    "mihomo-tk": "src/targets/cli.js",
    "mtk": "src/targets/cli.js"
  },
  "scripts": {
    "start": "node src/targets/server.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "build:worker": "esbuild src/targets/worker.js --bundle --outfile=dist/worker.bundle.js --format=esm --target=es2020 --platform=neutral --external:opencc-js --external:./src/chinese-convert.js --external:./src/fetch-proxy.js",
    "build": "node src/targets/cli.js -c config.yaml -t config",
    "build:nodes": "node src/targets/cli.js -c config.yaml -t nodes",
    "build:report": "node src/targets/cli.js -c config.yaml -t report",
    "dev": "node --watch src/targets/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoM-OVO/Mihomo-Toolkit.git"
  },
  "keywords": [
    "clash",
    "mihomo",
    "proxy",
    "subscription",
    "cleaner"
  ],
  "author": "XiaoM-OVO",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/XiaoM-OVO/Mihomo-Toolkit/issues"
  },
  "homepage": "https://github.com/XiaoM-OVO/Mihomo-Toolkit#readme",
  "dependencies": {
    "commander": "^15.0.0",
    "undici": "^8.10.0",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "opencc-js": "^1.4.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
